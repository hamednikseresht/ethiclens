{
  "name": "ethiclens",
  "version": "1.0.0",
  "description": "دستیار تصمیم‌گیری اخلاقی — تحلیل دوراهی‌های اخلاقی از منظر هفت مکتب فلسفه اخلاق",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "check": "node scripts/check-pages.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "node scripts/check-pages.mjs && node scripts/smoke.mjs && node scripts/signup-flow.mjs && node scripts/guide-flow.mjs && node scripts/otp-flow.mjs && node scripts/category-flow.mjs",
    "signup": "node scripts/signup-flow.mjs",
    "guide": "node scripts/guide-flow.mjs",
    "test:otp": "node scripts/otp-flow.mjs",
    "test:cats": "node scripts/category-flow.mjs",
    "build": "vite build",
    "dev:client": "vite"
  },
  "keywords": [
    "ethics",
    "philosophy",
    "decision-making",
    "nvidia-nim",
    "persian"
  ],
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "lucide-react": "^1.41.0",
    "nodemailer": "^9.1.1",
    "react-router-dom": "^7.18.3",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "qs": "^6.16.0"
  },
  "allowScripts": {
    "better-sqlite3": true
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
