# ---- سرور ----
PORT=3000
NODE_ENV=production

# رشته تصادفی و طولانی برای امضای کوکی نشست (حتماً عوض شود)
SESSION_SECRET=change-this-to-a-long-random-string

# پشت nginx با HTTPS این را روی 1 بگذارید
TRUST_PROXY=1
SECURE_COOKIE=0

# ---- پایگاه داده ----
DB_PATH=./data/ethiclens.db

# ---- ارائه‌دهندگان هوش مصنوعی ----
# هر کدام را که کلید دارید پر کنید؛ ارائه‌دهنده بی‌کلید خاموش می‌ماند.
# همه اینها را بعداً از پنل مدیریت هم می‌توان تغییر داد.

NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- ایمیل (میل‌گان) ----
# برای ارسال ایمیل تأیید حساب. اگر خالی بماند، حساب‌های تازه
# بدون تأیید ایمیل فعال می‌شوند. از پنل مدیریت هم قابل تنظیم است.
# سرویس ایمیل پیش‌فرض Brevo است. یکی از این دو دسته را پر کنید.
BREVO_API_KEY=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# حساب اروپایی: https://api.eu.mailgun.net
MAILGUN_BASE_URL=https://api.mailgun.net

# ---- حساب مدیر اولیه (فقط بار اول ساخته می‌شود) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=مدیر سامانه
