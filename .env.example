# ---- Server ----
PORT=3000
NODE_ENV=production

# A long random string signing the session cookie. Must be changed.
SESSION_SECRET=change-this-to-a-long-random-string

# Behind nginx with HTTPS, set both of these to 1.
TRUST_PROXY=1
SECURE_COOKIE=0

# ---- Database ----
DB_PATH=./data/ethiclens.db

# ---- Model providers ----
# Fill in whichever you have a key for; one without a key stays switched off.
# All of these can also be changed later from the admin panel.

NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek also exposes an OpenAI-compatible API, so it works the same way.
# Note: DeepSeek's max_tokens ceiling is lower than OpenAI's, and a global
# setting above it gets the request rejected. The app detects this and lowers
# the ceiling for this provider on its own.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- Email ----
# For account verification email. Left empty, new accounts are activated
# without email verification. Also configurable from the admin panel.
# Brevo is the default. Fill in one of the two groups.
BREVO_API_KEY=

MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# European account: https://api.eu.mailgun.net
MAILGUN_BASE_URL=https://api.mailgun.net

# ---- The first admin account (created on first boot only) ----
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=مدیر سامانه
