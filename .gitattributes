# Pins line endings regardless of each developer's core.autocrlf setting.
#
# The files under deploy/ run on a Linux server. Arriving there with Windows
# line endings (CRLF), bash trips over the \r and reports something opaque
# like: $'\r': command not found

*                     text=auto eol=lf

deploy/*.sh           text eol=lf
deploy/*.conf         text eol=lf
deploy/*.service      text eol=lf
*.sh                  text eol=lf

package-lock.json     text eol=lf -diff

*.png                 binary
*.jpg                 binary
*.ico                 binary
*.woff                binary
*.woff2               binary
